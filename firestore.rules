rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Sirf ye UIDs admin hain. Setup guide mein apna UID yahan paste karna.
    function isAdmin() {
      return request.auth != null
        && request.auth.uid in ['c6la5pHiqdZZqGVWDUGh4ZebUCk1'];
    }

    // Write ke time document ki shape check
    function validContentDoc() {
      return request.resource.data.keys().hasOnly(['content', 'updatedAt', 'updatedBy', 'publishedAt'])
        && request.resource.data.content is map
        && request.resource.data.updatedBy == request.auth.uid;
    }

    // Public website yahin se content padhti hai
    match /site/published {
      allow read: if true;
      allow create, update: if isAdmin() && validContentDoc();
      allow delete: if false;
    }

    // Draft sirf admin dekh aur badal sakta hai
    match /site/draft {
      allow read: if isAdmin();
      allow create, update: if isAdmin() && validContentDoc();
      allow delete: if false;
    }

    // Baaki sab kuch band
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
